 "meta": {
  "id": "7e2b9c4a0d53416fb8a7d21e95c6408f",
  "name": {
   "zh": "全身动作 · WHAM",
   "en": "Body Motion · WHAM"
  },
  "intro": {
   "zh": "WHAM 把 2D 关键点结合动捕数据和画面特征抬到三维，用摄影机角速度定出全局轨迹，并按脚与地面的接触修正。这张卡交付全身角色（SMPL）USD；选中的人以外由遮罩从画面抹掉后一趟解完。摄影机来源、选人、目标角色见各参数的提示。",
   "en": "WHAM lifts 2D keypoints to 3D using mocap data and image features, sets the global trajectory from the camera's angular velocity, and corrects it by foot-ground contact. This card delivers a full-body character (SMPL) USD; people other than the chosen ones are masked out of the image and everything is solved in one pass. See each parameter's tip for Camera Source, People to Solve and Target Character."
  },
  "author": "Lab2Shot",
  "created": "2026-09-20T10:00:00",
  "deliverable": "body_video",
  "owner": "admin",
  "updated": "2026-10-03T01:00:00"
 },
