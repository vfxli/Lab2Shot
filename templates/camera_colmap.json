 "meta": {
  "id": "2f0998c6599da944d4d77a89e783ecb0",
  "name": "相机解算 · COLMAP",
  "intro": "COLMAP 官方自述是通用的运动恢复结构（SfM）与多视图立体（MVS）流程，成组画面无论有序无序都能算。这张卡用它解算每帧相机，交付带一层稀疏点云的相机 USD 和 Nuke 相机。勾「显卡提取特征」（SiftGPU）时整张卡按非商用算。镜头模型选带畸变的时，同时交付去畸变 EXR（画面与两张 ST-map）。",
  "author": "Lab2Shot",
  "created": "2026-09-11T11:00:00",
  "deliverable": "camera_traj",
  "owner": "admin",
  "updated": "2026-10-01T05:00:00"
 },
