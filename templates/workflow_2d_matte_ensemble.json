 "meta": {
  "id": "2544e5d36789400e9974c5e9d7a27200",
  "name": {
   "zh": "2D 抠像（模型集成）",
   "en": "2D Matte (Model Ensemble)"
  },
  "intro": {
   "zh": "抠像集成：BiRefNet、VideoMaMa（用 BiRefNet 粗遮罩）、MatAnyone 2（用你点选的物体）合成一张，先剔掉找错对象的再按权重合成；用「稳健」目标，117 条素材上比 VideoMaMa 稳 7.8%、没有一条找错对象。默认只交付集成结果。",
   "en": "Matte ensemble: BiRefNet, VideoMaMa (on its mask) and MatAnyone 2 (on your picked object), wrong-object candidates left out, the rest averaged; Robustness objective (7.8% steadier than VideoMaMa on 117 clips, no wrong object). Only the ensemble is delivered by default."
  },
  "author": "Lab2Shot",
  "created": "2026-10-04T16:00:00",
  "updated": "2026-10-04T21:30:00",
  "deliverable": "workflow",
  "owner": "admin"
 },
