 "meta": {
  "id": "ca0500e879964171880c6df356139034",
  "name": "动作生成 · Kimodo",
  "intro": "Kimodo 是在 700 小时可商用光学动捕上训练的运动学动作扩散模型，由文字描述生成人体和机器人动作。这张卡不用素材：写一句英文描述、定好帧范围，默认重定向到「标准人」（SMPL-X 体型，非商用且需注册）；商用请换成导入的 FBX / USD 角色或选「原骨架」（G1 机器人要选它）；模型选 SMPL-X 时仅限研究。",
  "author": "Lab2Shot",
  "created": "2026-09-22T12:00:00",
  "deliverable": "motion_gen",
  "owner": "admin",
  "updated": "2026-10-01T12:00:00"
 },
