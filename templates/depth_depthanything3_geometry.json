 "meta": {
  "id": "c30371c6780b4d24bb2880d9bef3f984",
  "name": "深度图 · Depth Anything 3",
  "intro": "Depth Anything 3 官方自述：从任意视觉输入预测空间一致的几何；官方称单目深度估计优于 Depth Anything V2。这张卡逐帧交付深度图和相机，填「已知 Focal Length」并把「模型」换成 Metric-Large 可得真实尺度。模型选 Large / Giant 时按非商用算。",
  "author": "Lab2Shot",
  "created": "2026-09-21T16:00:00",
  "deliverable": "depth_image",
  "owner": "admin",
  "updated": "2026-10-01T05:00:00"
 },
 "exposed": [
  {
   "name": "input",
   "label": "输入序列",
   "target": "read.path",
   "show_on_change": true
  },
  {
   "name": "colorspace_in",
   "label": "输入色彩空间",
   "target": "read.colorspace",
   "show_on_change": true
  },
  {
   "name": "first_frame",
   "label": "首帧",
   "target": "read.first"
  },
  {
   "name": "last_frame",
   "label": "末帧",
   "target": "read.last"
  },
  {
   "kind": "group",
   "label": "镜头",
   "collapsed": false,
   "children": [
    {
     "name": "focal",
     "label": "已知 Focal Length",
     "target": "geo.focal_mm"
    },
    {
     "name": "filmback",
     "label": "Filmback",
     "target": "geo.filmback_mm",
     "disable_when": "not focal"
    }
   ]
  },
  {
   "kind": "group",
   "label": "深度",
   "collapsed": false,
   "children": [
    {
     "name": "model",
     "label": "模型",
     "target": "geo.model"
    },
    {
     "name": "resolution",
     "label": "处理分辨率",
     "target": "geo.resolution"
    },
    {
     "kind": "group",
     "label": "高级",
     "collapsed": true,
     "children": [
      {
       "name": "ray_pose",
       "label": "光线求 Focal Length",
       "target": "geo.ray_pose",
       "disable_when": "focal or model == \"da3metric-large\""
      }
     ]
    },
    {
     "name": "cook_depth",
     "label": "计算深度图",
     "target": "geo.cook"
    }
   ]
  },
  {
   "kind": "group",
   "label": "交付",
   "collapsed": false,
   "children": [
    {
     "name": "exr_name",
     "label": "文件名（深度 EXR）",
     "target": "exr.name"
    },
    {
     "name": "usd_name",
     "label": "文件名（相机 USD）",
     "target": "out_p.name"
    },
    {
     "name": "unit",
     "label": "单位",
     "target": "out_p.unit"
    },
    {
     "name": "fps",
     "label": "帧率",
     "target": "out_p.fps"
    },
    {
     "kind": "group",
     "label": "高级",
     "collapsed": true,
     "children": [
      {
       "name": "exr_compression",
       "label": "EXR 压缩",
       "target": "exr.exr_compression",
       "widget": "menu",
       "options": [
        {
         "value": "zips",
         "label": "ZIP 逐行"
        },
        {
         "value": "zip",
         "label": "ZIP 16 行"
        },
        {
         "value": "piz",
         "label": "PIZ"
        },
        {
         "value": "none",
         "label": "无"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "kind": "group",
   "label": "操作",
   "collapsed": false,
   "children": [
    {
     "name": "cook",
     "label": "打包",
     "target": "deliver.cook"
    },
    {
     "name": "download",
     "label": "下载",
     "target": "deliver.download"
    }
   ]
  }
 ],
