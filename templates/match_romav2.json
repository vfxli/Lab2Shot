   "name": "reference",
   "label": "参考图",
   "target": "ref.path",
   "show_on_change": true
  },
  {
   "name": "colorspace_in_reference",
   "label": "参考图色彩空间",
   "target": "ref.colorspace",
   "show_on_change": true
  },
  {
   "name": "setting",
   "label": "精度",
   "target": "match.setting"
  },
  {
   "name": "matches",
   "label": "匹配点数",
   "target": "match.matches"
  },
  {
   "name": "comp_opacity",
   "label": "对齐图不透明度",
   "target": "comp.mix",
   "tip": "只影响预览里对齐图的叠加，不进交付"
  },
  {
   "name": "cook_match",
   "label": "匹配",
   "target": "comp.cook"
  },
  {
   "kind": "group",
   "label": "交付",
   "collapsed": false,
   "children": [
    {
     "name": "exr_name",
     "label": "文件名（EXR）",
     "target": "out.name"
    },
    {
     "name": "colorspace_out",
     "label": "输出色彩空间",
     "target": "out.colorspace"
    },
    {
     "name": "tracks_format",
     "label": "匹配点格式",
     "target": "track_format.value",
     "widget": "menu",
     "options": [
      {
       "value": "3de",
       "label": "3DE"
      },
      {
       "value": "tracker",
       "label": "Nuke Tracker"
      },
      {
       "value": "csv",
       "label": "CSV"
      }
     ],
     "hide_when": "matches == 0"
    },
    {
     "name": "plate_points_name",
     "label": "文件名（画面匹配点）",
     "target": "pts.name",
     "hide_when": "matches == 0"
    },
    {
     "name": "reference_points_name",
     "label": "文件名（参考图匹配点）",
     "target": "rpts.name",
     "hide_when": "matches == 0"
    },
    {
     "label": "坐标原点",
     "name": "origin",
     "target": "track_origin.value",
     "hide_when": "(matches == 0) or tracks_format != \"csv\"",
     "widget": "menu",
     "options": [
      {
       "value": "bottom_left",
       "label": "左下"
      },
      {
       "value": "top_left",
       "label": "左上"
      }
     ]
    },
    {
     "kind": "group",
     "label": "高级",
     "collapsed": true,
     "children": [
      {
       "name": "exr_bit_depth",
       "label": "EXR 位深",
       "target": "out.exr_bit_depth"
      },
      {
       "name": "exr_compression",
       "label": "EXR 压缩",
       "target": "out.exr_compression",
       "widget": "menu",
       "options": [
        {
         "value": "zips",
         "label": "ZIP 逐行"
        },
        {
         "value": "zip",
         "label": "ZIP 16 行"
        },
        {
         "value": "piz",
         "label": "PIZ"
        },
        {
         "value": "none",
         "label": "无"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "kind": "group",
   "label": "操作",
   "collapsed": false,
   "children": [
    {
     "name": "cook",
     "label": "打包",
     "target": "deliver.cook"
    },
    {
     "name": "download",
     "label": "下载",
     "target": "deliver.download"
    }
   ]
  }
 ],
