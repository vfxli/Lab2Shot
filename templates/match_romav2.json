{
 "schema": "lab2shot.graph/1",
 "meta": {
  "id": "7477490c915e1e29505354d37e43371f",
  "name": "图像对位 · RoMa v2",
  "intro": "稠密特征匹配要估计同一个三维场景两张画面之间的全部对应关系；RoMa v2 用新的匹配架构和损失，精度明显超过前几代。这张卡把参考图对齐到画面上，按「匹配」看对齐图盖到画面上的效果，交付一套多层 EXR（对齐后的参考图 aligned、ST-map、置信度）和两边的匹配点。",
  "author": "Lab2Shot",
  "created": "2026-09-13T09:00:00",
  "deliverable": "match",
  "owner": "admin",
  "updated": "2026-10-01T05:00:00"
 },
 "exposed": [
  {
   "name": "input",
   "label": "画面",
   "target": "read.path",
   "show_on_change": true
  },
  {
   "name": "colorspace_in",
   "label": "输入色彩空间",
   "target": "read.colorspace",
   "show_on_change": true
  },
