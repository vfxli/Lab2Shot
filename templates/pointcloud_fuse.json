 "meta": {
  "id": "93aba99b2601bba9bf18caf75c155668",
  "name": {
   "zh": "点云 · TSDF 融合",
   "en": "Point Cloud · TSDF Fusion"
  },
  "intro": {
   "zh": "把一整个镜头里逐帧的深度（加摄影机）融成一片静止的全局点云：帧与帧之间大量重复的点按 TSDF 去重去噪。点的颜色取自输入画面（每个点来源那一帧、那个像素，融合时平均）。「体素大小」控制去重力度；接「逐帧点云」则按体素拼接（把深度口换掉即可）。",
   "en": "Fuses the per-frame depth (with the camera) of a whole shot into one static global point cloud: the many points repeated from frame to frame are deduplicated and denoised by TSDF. Point colors come from the input images (each point's source frame and pixel, averaged during fusion). Voxel Size controls the deduplication; wiring Per-Frame Point Clouds instead merges by voxel (just swap the depth input)."
  },
  "author": "Lab2Shot",
  "created": "2026-10-02T00:00:00",
  "deliverable": "points_mesh",
  "owner": "admin",
  "updated": "2026-10-03T20:00:00"
 },
