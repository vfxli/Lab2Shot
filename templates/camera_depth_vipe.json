  "name": "相机与深度 · ViPE",
  "intro": "ViPE 官方自述：从无约束的原始视频估计相机内参、相机运动和接近真实尺度的稠密深度图。官方把它分成两段跑——先解位姿，再在位姿上估计深度图；这张卡就照这两段接成两个节点，交付相机（USD 与 Nuke 相机）和与它对齐的深度图。",
  "author": "Lab2Shot",
  "created": "2026-09-11T11:00:00",
  "deliverable": "depth_solved",
  "owner": "admin",
  "updated": "2026-10-01T05:00:00"
 },
