  "name": {
   "zh": "运动物体遮罩 · SegAnyMo",
   "en": "Moving Object Mask · SegAnyMo"
  },
  "intro": {
   "zh": "SegAnyMo 把长距离轨迹的运动线索和 DINO 的语义特征结合起来做运动物体分割，再用 SAM 2 以迭代提示把遮罩加密到像素级。这张卡交付整段运动物体遮罩和按物体区分的分割结果。",
   "en": "SegAnyMo combines motion cues from long-range trajectories with DINO semantic features to segment moving objects, then densifies the masks to pixel level with SAM 2 through iterative prompting. This card delivers moving-object masks for the whole shot and per-object segmentation."
  },
  "author": "Lab2Shot",
  "created": "2026-09-13T12:00:00",
  "deliverable": "mask",
  "owner": "admin",
  "updated": "2026-10-03T01:00:00"
 },
