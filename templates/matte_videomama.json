 "meta": {
  "id": "4f6c67d0030286b4a403f9a8dfb4bd4b",
  "name": "精细抠像 · VideoMaMa",
  "intro": "VideoMaMa 是遮罩引导的视频抠像框架，借用视频生成先验，在各类素材上表现稳定，抠像质量精细。这张卡的逐帧粗遮罩默认由 BiRefNet 给出，也可以用 SAM 3 按提示词找再点选物体（整段跟住），固定机位还可以自己画一张；抠出整段 alpha 后用「边缘解混合」去掉边缘的背景色，交付一套多层 EXR（rgba 修正后前景、foreground 未修正前景、alpha）。",
  "author": "Lab2Shot",
  "created": "2026-09-11T11:00:00",
  "deliverable": "matte_fine",
  "owner": "admin",
  "updated": "2026-10-01T05:00:00"
 },
