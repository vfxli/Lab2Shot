 "meta": {
  "id": "cf8e598b7bc32ac02902efd7a330bd48",
  "name": "动作生成 · Sketch2Anim 画线",
  "intro": "Sketch2Anim 把分镜草图变成三维动画：三维关键姿势、关节轨迹和动作词控制的生成器，加一层把草图对到同一空间的映射。这张卡在空画布上画火柴人，默认重定向到「标准人」（SMPL-X，需注册）交付蒙皮角色 USD；不想注册就在「目标角色」选「原骨架」。整张卡仅限研究（权重用 AMASS 训练）。",
  "author": "Lab2Shot",
  "created": "2026-09-20T13:00:00",
  "deliverable": "motion_gen",
  "owner": "admin",
  "updated": "2026-10-01T12:00:00"
 },
