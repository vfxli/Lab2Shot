 "meta": {
  "id": "c1c58f9b067565c03a58479f6926ca7f",
  "name": "动作补帧 · Kimodo",
  "intro": "Kimodo 是在 700 小时可商用光学动捕上训练的运动学动作扩散模型，由文字描述和全身姿势关键帧这类约束控制。这张卡拿导入角色的关键帧当约束，补出中间动作；可以原样交付这个角色，也可以在「目标角色」里选导入的 FBX / USD 角色重定向过去，交付 USD。模型选 SMPL-X 时这张卡按仅限研究算。",
  "author": "Lab2Shot",
  "created": "2026-09-12T12:00:00",
  "deliverable": "motion_gen",
  "owner": "admin",
  "updated": "2026-10-01T12:00:00"
 },
