  "id": "3d1733b1958108c7bcb0a010ff9c6eb7",
  "name": "全身动作 · SAM 3D Body",
  "intro": "SAM 3D Body 是可提示的模型，从单张画面恢复全身三维人体网格（Momentum Human Rig，含脚与手）。这张卡先检出画面里的人、分批解，交付全身角色 USD；相机来源、选人、目标角色的用法见各参数的提示。整张卡可商用。",
  "author": "Lab2Shot",
  "created": "2026-09-11T06:00:00",
  "deliverable": "body_full",
  "owner": "admin",
  "updated": "2026-10-01T12:00:00"
 },
