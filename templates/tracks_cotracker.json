  "name": {
   "zh": "2D 跟踪点 · CoTracker3",
   "en": "2D Tracks · CoTracker3"
  },
  "intro": {
   "zh": "CoTracker3 是基于 transformer 的快速模型，能跟住视频里的任意一个点，点可以手选，也可以在任意一帧上按网格撒。这张卡默认撒 10×10＝100 个网格点，交付 Nuke 的 Tracker 节点。",
   "en": "CoTracker3 is a fast transformer-based model that tracks any point in a video; points can be picked by hand or scattered as a grid on any frame. This card scatters a 10×10 = 100 point grid by default and delivers a Nuke Tracker node."
  },
  "author": "Lab2Shot",
  "created": "2026-09-11T11:00:00",
  "deliverable": "tracks2d",
  "owner": "admin",
  "updated": "2026-10-03T01:00:00"
 },
