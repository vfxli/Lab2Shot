       "options": [
        {
         "value": "zips",
         "label": "ZIP 逐行"
        },
        {
         "value": "zip",
         "label": "ZIP 16 行"
        },
        {
         "value": "piz",
         "label": "PIZ"
        },
        {
         "value": "none",
         "label": "无"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "kind": "group",
   "label": "操作",
   "collapsed": false,
   "children": [
    {
     "name": "cook",
     "label": "计算",
     "target": "deliver.cook"
    },
    {
     "name": "download",
     "label": "下载",
     "target": "deliver.download"
    }
   ]
  }
 ],
