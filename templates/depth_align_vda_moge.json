  "name": {
   "zh": "深度贴图 · Video Depth Anything 定尺度",
   "en": "Depth Map · Video Depth Anything Metric"
  },
  "intro": {
   "zh": "Video Depth Anything 官方自述：基于 Depth Anything V2，任意长度的视频都能算，质量、一致性和泛化能力不打折。这张卡再按 MoGe 的真实尺度深度贴图把它定到厘米。Video Depth Anything 模型选 Base / Large 时按非商用算。",
   "en": "Video Depth Anything describes itself as built on Depth Anything V2, handling videos of any length without losing quality, consistency or generalization. This card then scales it to centimeters using MoGe's metric depth maps. With the Video Depth Anything model set to Base / Large, the card counts as non-commercial."
  },
  "author": "Lab2Shot",
  "created": "2026-09-12T12:00:00",
  "deliverable": "depth_video",
  "owner": "admin",
  "updated": "2026-10-03T01:00:00"
 },
