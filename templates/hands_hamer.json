 "meta": {
  "id": "d1787b82183d9e8ff7a317890279e166",
  "name": "手部动作 · HaMeR",
  "intro": "HaMeR 用全 Transformer 架构从单目画面恢复手的三维形态。这张卡给每个人的左右手各交付一只 MANO 手：只用 Focal Length 把手解在相机前，再逐帧摆进所选相机的世界；也可以导入只有手的 FBX / USD 绑定，按手腕和五指重定向、蒙皮后交付（一次一只手）。",
  "author": "Lab2Shot",
  "created": "2026-09-11T11:00:00",
  "deliverable": "hands",
  "owner": "admin",
  "updated": "2026-10-01T12:00:00",
  "own_interface": [
   "core.retarget"
  ]
 },
