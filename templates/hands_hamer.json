 "meta": {
  "id": "d1787b82183d9e8ff7a317890279e166",
  "name": {
   "zh": "手部动作 · HaMeR",
   "en": "Hand Motion · HaMeR"
  },
  "intro": {
   "zh": "HaMeR 用全 Transformer 架构从单目画面恢复手的三维形态。这张卡给每个人的左右手各交付一只 MANO 手：只用 焦距 把手解在摄影机前，再逐帧摆进所选摄影机的世界；也可以导入只有手的 FBX / USD 装备，按手腕和五指重定目标、蒙皮后交付（一次一只手）。",
   "en": "HaMeR recovers 3D hands from monocular images with a fully transformer-based architecture. This card delivers one MANO hand for each person's left and right hand: the hand is solved in front of the camera from the focal length alone, then placed per frame into the chosen camera's world; you can also import a hand-only FBX / USD rig, retargeted by the wrist and fingers and skinned before delivery (one hand at a time)."
  },
  "author": "Lab2Shot",
  "created": "2026-09-11T11:00:00",
  "deliverable": "body_full",
  "owner": "admin",
  "updated": "2026-10-03T01:00:00",
  "own_interface": [
   "retarget"
  ]
 },
