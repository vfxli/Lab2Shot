  "name": {
   "zh": "平面跟踪 · WOFTSAM",
   "en": "Planar Track · WOFTSAM"
  },
  "intro": {
   "zh": "WOFTSAM 是分割引导的单应估计，用于长时平面跟踪，在 POT-210 和 PlanarTrack 两个平面物体基准上成绩最好。这张卡框出平面的四个角，跟满整段镜头，交付 Nuke 的 CornerPin2D。",
   "en": "WOFTSAM is segmentation-guided homography estimation for long-term planar tracking, scoring best on the POT-210 and PlanarTrack planar object benchmarks. This card marks the four corners of a plane, tracks them through the whole shot and delivers a Nuke CornerPin2D."
  },
  "author": "Lab2Shot",
  "created": "2026-09-13T12:00:00",
  "deliverable": "tracks2d",
  "owner": "admin",
  "updated": "2026-10-03T01:00:00"
 },
