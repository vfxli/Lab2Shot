  "id": "0f92f26336541f5500f11ee098f457ea",
  "name": "跟踪贴片 · AllTracker",
  "intro": "AllTracker 估计查询帧到其余每一帧的流场，由此得到长距离的点轨迹，结果是高分辨率的稠密全像素对应。这张卡在参考帧上画一次（修补、纹身、贴图），按 ST-map 贴满整段镜头；按「贴片」看贴片盖到原图上的效果（A over B），交付一套多层 EXR（贴片 rgba、ST-map、置信度）。",
  "author": "Lab2Shot",
  "created": "2026-09-13T09:00:00",
  "deliverable": "paint",
  "owner": "admin",
  "updated": "2026-10-01T05:00:00"
 },
