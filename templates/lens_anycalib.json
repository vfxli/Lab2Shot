  "name": {
   "zh": "镜头标定 · AnyCalib",
   "en": "Lens Calibration · AnyCalib"
  },
  "intro": {
   "zh": "AnyCalib 从一张实拍画面标定摄影机内参，与镜头模型无关。这张卡交付去畸变的素材、两张 ST 贴图 和一台摄影机；扭画面在「STMap」里做，按「LensDistortion」烘出的 ST 贴图，节点图上看得见。",
   "en": "AnyCalib calibrates camera intrinsics from a single real image, independent of the lens model. This card delivers undistorted footage, two ST maps and a camera; the image is warped in STMap using the ST maps baked by LensDistortion, visible in the network."
  },
  "author": "Lab2Shot",
  "created": "2026-09-11T11:00:00",
  "deliverable": "lens_calib",
  "owner": "admin",
  "updated": "2026-10-03T01:00:00"
 },
