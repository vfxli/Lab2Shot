/* generated by tools/dcc_theme.py from theme.qss.in and webui/src/ui/tokens.css; do not edit */
/* The panel's Qt rules (设计_DCC新面板.md §2). Values only as the at-brace placeholders of webui/src/ui/tokens.css: tools/dcc_theme.py
   fills them into theme.qss. Set on our own windows only (theme.apply); selectors are our objectNames and dynamic
   properties. What Qt cannot do (shadows, blur, transitions) is left out: depth is the surfaces' lightness. */

#L2SRoot, #L2SDialog { background-color: #13161a; }
QWidget { color: #e6eaf0; font-size: 12px; }
QWidget#L2SScrollBody, QWidget#L2SHomeBody, QWidget#L2SToolBody, QWidget#L2SVersionStrip, QWidget#L2SViewport,
QStackedWidget#L2SStack { background: transparent; }
QScrollArea#L2SScroll, QScrollArea#L2SVersionScroll { background: transparent; border: none; }
QLabel { background: transparent; }

QLabel[l2s="muted"] { color: #a1a9b4; }
QLabel[l2s="faint"] { color: #69717c; font-size: 12px; }
QLabel[l2s="title"] { font-size: 18px; font-weight: 600; }
QLabel[l2s="heading"] { font-size: 14px; font-weight: 600; }
QLabel[l2s="section"] { color: #a1a9b4; font-size: 12px; font-weight: 600; }
QLabel[l2s="cardtitle"] { font-size: 14px; font-weight: 600; }
QLabel[l2s="crumb"] { color: #a1a9b4; }
QLabel[l2s="chip"] { color: #a1a9b4; font-size: 12px; }
QLabel[l2s="error"] { color: #d6bdff; }
QLabel[l2s="warn"] { color: #f6cf82; }
QLabel[l2s="ok"] { color: #43d38b; font-size: 12px; }

/* the top bar: the window's own darkest surface, a hairline under it */
#L2STopBar { background-color: #0b0d10; border-bottom: 1px solid rgba(190, 205, 225, 20); }
QToolButton#L2SBack { color: #a1a9b4; border: none; border-radius: 7px; padding: 3px 8px 3px 4px; }
QToolButton#L2SBack:hover { background-color: #2a3037; color: #e6eaf0; }
QToolButton#L2SIconButton { border: none; border-radius: 7px; padding: 4px; }
QToolButton#L2SIconButton:hover { background-color: #2a3037; }
QToolButton#L2SIconButton::menu-indicator { image: none; width: 0px; }

#L2SBanner { background-color: rgba(242, 180, 65, 33); border: 1px solid rgba(242, 180, 65, 89); border-radius: 9px; }
#L2SBanner[kind="error"] { background-color: rgba(106, 168, 255, 36); border-color: rgba(106, 168, 255, 128); }

/* buttons: a control's own surface, lighter on hover; one filled main button */
QPushButton#L2SButton { background-color: #21262d; border: none; border-radius: 7px; padding: 5px 10px; }
QPushButton#L2SButton:hover { background-color: #2a3037; }
QPushButton#L2SButton:pressed { background-color: #20252b; }
QPushButton#L2SButton:disabled { color: #69717c; background-color: #191d22; }
QPushButton#L2SGhost { background: transparent; border: none; border-radius: 7px; padding: 5px 8px; color: #a1a9b4; }
QPushButton#L2SGhost:hover { background-color: #2a3037; color: #e6eaf0; }
QPushButton#L2SGhost:disabled { color: #69717c; }
QPushButton#L2SPrimary { background-color: #3b82f6; color: #fff; border: none; border-radius: 9px;
    padding: 8px 16px; font-size: 14px; font-weight: 600; }
QPushButton#L2SPrimary:hover { background-color: #6aa8ff; }
QPushButton#L2SPrimary:disabled { background-color: #20252b; color: #69717c; }
QPushButton#L2SPrimary[busy="true"] { background-color: #2a3037; color: #e6eaf0; }
QPushButton#L2SPrimary[busy="true"]:hover { background-color: #20252b; }

/* fields: the well a value is typed into */
QLineEdit, QComboBox { background-color: #0e1115; border: 1px solid rgba(190, 205, 225, 20); border-radius: 9px;
    padding: 4px 8px; selection-background-color: #3b82f6; selection-color: #fff; }
QLineEdit:focus, QComboBox:focus { border-color: rgba(106, 168, 255, 128); }
QLineEdit:disabled, QComboBox:disabled { color: #69717c; }
QLineEdit#L2SSearch { padding: 6px 10px; border-radius: 9px; font-size: 14px; }
QComboBox QAbstractItemView { background-color: #1a1e23; border: 1px solid rgba(190, 205, 225, 38); outline: 0;
    selection-background-color: rgba(106, 168, 255, 36); selection-color: #e6eaf0; }
QCheckBox { spacing: 6px; }

/* cards: lifted off the panel; lighter under the pointer */
#L2SCard, #L2STask, #L2SVersion { background-color: #191d22; border: 1px solid rgba(190, 205, 225, 20); border-radius: 13px; }
#L2SCard[hover="true"], #L2STask[hover="true"], #L2SVersion[hover="true"] { background-color: #2a3037;
    border-color: rgba(190, 205, 225, 38); }
#L2STask { border-radius: 9px; }
#L2STask[current="true"] { border-color: rgba(106, 168, 255, 128); }
#L2SVersion { border-radius: 9px; }
#L2SVersion[imported="false"] { border-color: rgba(242, 180, 65, 89); }
#L2SChip { background-color: rgba(190, 205, 225, 36); border-radius: 5px; }
#L2SChip[faint="true"] { background-color: rgba(255, 255, 255, 13); }

/* the tool page */
#L2SInput { background-color: #191d22; border: 1px solid rgba(190, 205, 225, 20); border-radius: 13px; }
#L2SInput[bound="true"] { border-color: rgba(67, 211, 139, 89); }
QLabel#L2SStepNumber { background-color: rgba(106, 168, 255, 36); color: #a9cbff; border-radius: 10px;
    font-size: 12px; font-weight: 600; }
QLabel#L2SFromScene { background-color: rgba(106, 168, 255, 36); color: #a9cbff; border-radius: 5px;
    padding: 0px 5px; font-size: 11px; }
QToolButton#L2SFold { border: none; color: #a1a9b4; font-weight: 600; padding: 2px 0px; }
QToolButton#L2SFold:hover { color: #e6eaf0; }
QProgressBar#L2SProgress { background-color: #0e1115; border: none; border-radius: 3px; }
QProgressBar#L2SProgress::chunk { background-color: #6aa8ff; border-radius: 3px; }

/* tabs: a quiet row; the chosen one a lifted segment */
QPushButton#L2STab { background: transparent; border: none; border-radius: 7px; padding: 4px 10px;
    color: #a1a9b4; }
QPushButton#L2STab:hover { background-color: rgba(255, 255, 255, 20); color: #e6eaf0; }
QPushButton#L2STab:checked { background-color: #20252b; color: #e6eaf0; font-weight: 600; }

#L2SHair { background-color: rgba(190, 205, 225, 20); border: none; }

/* what floats: menus and tooltips (the page's glass, solid here: Qt has no blur) */
QMenu { background-color: #1a1e23; border: 1px solid rgba(190, 205, 225, 38); border-radius: 9px; padding: 4px; }
QMenu::item { padding: 5px 22px 5px 12px; border-radius: 5px; color: #e6eaf0; }
QMenu::item:selected { background-color: rgba(106, 168, 255, 36); }
QMenu::item:disabled { color: #69717c; }
QMenu::separator { height: 1px; background: rgba(190, 205, 225, 20); margin: 4px 6px; }
QToolTip { background-color: #1a1e23; color: #e6eaf0; border: 1px solid rgba(190, 205, 225, 38); padding: 4px 6px; }

QScrollBar:vertical { background: transparent; width: 8px; margin: 0px; }
QScrollBar::handle:vertical { background: rgba(190, 205, 225, 38); border-radius: 4px; min-height: 28px; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0px; }
QScrollBar::handle:horizontal { background: rgba(190, 205, 225, 38); border-radius: 4px; min-width: 28px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QListWidget { background-color: #0e1115; border: 1px solid rgba(190, 205, 225, 20); border-radius: 9px; }
QListWidget::item { padding: 4px 6px; }

QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid rgba(190, 205, 225, 38); border-radius: 5px;
    background-color: #0e1115; }
QCheckBox::indicator:hover { border-color: rgba(106, 168, 255, 128); }
QCheckBox::indicator:checked { background-color: #3b82f6; border-color: #3b82f6; }
QCheckBox::indicator:disabled { background-color: #191d22; border-color: rgba(190, 205, 225, 20); }
